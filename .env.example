# Backend Server Configuration
PORT=8001

# Deepgram API Key for Speech-to-Text service
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ElevenLabs API Key for Text-to-Speech service
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Key (optional). If set, replies and mood analysis use OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# Gemini API Key. Used for replies when no OpenAI key is set, and always for embeddings, Ask Mr Brown and insights.
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL with pgvector (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5436/clara_voice_journal"

# Optional. Redis for caching and rate limits; the app runs without it.
# REDIS_URL="redis://127.0.0.1:6379"

# JWT configuration (secure strings for authentication tokens)
JWT_ACCESS_SECRET="generate_a_long_random_string_here_for_access_secret"
JWT_REFRESH_SECRET="generate_a_long_random_string_here_for_refresh_secret"